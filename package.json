{
  "name": "dsh-onebot-genji",
  "version": "0.17.0",
  "description": "由 InsaneGenji 维护的 QQ 通道分叉（fork 自 dsh-onebot-qq@0.11.0）：在 OneBot 11 / NapCat 通道基础上加了表情包库（未审核/已审核、模型看图写标签、重新识别）、主动搭话、QQ 空间说说、回合形式掷骰（语音条、表情包概率）、正文气泡切分、群聊上下文与自带语音转写桥。仓库 github.com/InsaneGenji/dsh-onebot-genji，上游 github.com/mario841859784/dsh-onebot .",
  "keywords": [
    "dsh",
    "onebot",
    "onebot11",
    "qq",
    "qq-bot",
    "qqbot",
    "napcat",
    "lagrange",
    "llonebot",
    "go-cqhttp",
    "qzone",
    "deepseek",
    "deepseek-harness",
    "harness",
    "bridge",
    "chatbot"
  ],
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./settings-remote": "./lib/settings-remote.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/*.bak-*",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsaneGenji/dsh-onebot-genji.git"
  },
  "homepage": "https://github.com/InsaneGenji/dsh-onebot-genji#readme",
  "bugs": {
    "url": "https://github.com/InsaneGenji/dsh-onebot-genji/issues"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.1-0 <0.3.0-0 || >=0.2.2-0 <0.2.3-0",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "qq_send_text",
        "qq_send_image",
        "qq_send_voice",
        "qq_send_video",
        "qq_send_file",
        "qq_send_forward",
        "qq_napcat_api",
        "qq_group_history"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0 || >=0.2.2-0 <0.2.3-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-util-values": ">=0.1.5-rc.1 <0.1.6-0 || >=0.1.6-alpha.1 <0.1.7-0 || >=0.1.7-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.0 || >=3.18.6-alpha.1 <3.19.0-0",
    "schemastery": "^3.18.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "fontkit": "^2.0.4",
    "schemastery": "^3.18.0",
    "silk-wasm": "^3.7.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "gifuct-js": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "./scripts/build.sh",
    "test": "vitest run",
    "replay": "node scripts/replay.mjs",
    "verify:injected-context": "node scripts/verify-injected-context.mjs",
    "verify:lan-management": "node scripts/verify-lan-management.mjs"
  }
}
